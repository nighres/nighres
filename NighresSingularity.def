Bootstrap: docker
From: ubuntu:22.04


%post
    apt -y update
    apt -y upgrade
    apt -y install git python-is-python3 python3-pip curl locales wget
	locale-gen en_US.UTF-8

	# git-lfs
    curl -s https://packagecloud.io/install/repositories/github/git-lfs/script.deb.sh | bash
    apt-get install git-lfs
    git lfs install

    #JCC
	curl https://download.java.net/java/GA/jdk20.0.1/b4887098932d415489976708ad6d1a4b/9/GPL/openjdk-20.0.1_linux-x64_bin.tar.gz | tar -zx -C /opt --transform='s/jdk-20.0.1/jdk-temurin-20.0.1/'

	export JCC_JDK=/opt/jdk-temurin-20.0.1
	export JAVAHOME=/opt/jdk-temurin-20.0.1
	export PATH=$PATH:$JAVAHOME/bin

	pip3 install JCC matplotlib nilearn Cython ninja meson-python
	
	#nighres
	cd /tmp
	rm -rf nighres
	git clone https://github.com/piloubazin/nighres.git 
	cd nighres
	make update_dep_shasum
	make install
	
	# additional libraries
	pip3 install pandas

%environment
	export JCC_JDK=/opt/jdk-temurin-20.0.1
	export JAVAHOME=/opt/jdk-temurin-20.0.1
	export PATH=$PATH:$JAVAHOME/bin


